# YokaHub Team Project .gitignore
# Logs & Build outputs
dist/
*.log
*.tmp
__pycache__/

# Private keys, tokens & secrets (Tuyệt đối không đẩy lên GitHub)
private_token.txt
audit_live.log
private_keys.json
private_salt.txt
sepay_token.txt
webhook_private.txt
webhook_boss_api.txt
CombinedSettings.json

# Temporary tools & inspect scripts
tools/inspect_*.py
tools/test_*.py
tools/check_*.py

# Local IDE & OS files
.vscode/
.idea/
Thumbs.db
.DS_Store
